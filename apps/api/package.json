{
  "name": "@concept/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit -p .",
    "test": "tsx --test src/*.test.ts",
    "db:migrate": "tsx prisma/migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "tsx prisma/migrate.ts && tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "deploy:prepare": "tsx prisma/migrate.ts && tsx prisma/bootstrap.ts"
  },
  "dependencies": {
    "@concept/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
